#!/usr/bin/env node
/**
 * This is readonly file
 */
const cmdAlias = 'naf';
import inquirer from 'inquirer';
import fs from 'fs';
import fsExtra from 'fs-extra';
import shell from 'shelljs';
import chalk from 'chalk';
import path from 'path';
import { parseArgs } from 'util';

const projectInitDir = path.dirname(import.meta.dirname);
const projectDir = process.cwd();
const srcDir = `${projectDir}/src/`;
// template dir for crud action
const templateCrudDir = `${projectInitDir}/bin/templates/crud/`;
// template dir for empty file
const templateNewDir = `${projectInitDir}/bin/templates/new/`;
// Claude Code skill installed in the projects
const templateSkillPath = `${projectInitDir}/bin/templates/skill/SKILL.md`;
const skillPath = '.claude/skills/naf/SKILL.md';
const routeDir = `${srcDir}routes/`;

// get from node process
const actor = process.argv[2];

/**
 * Options for running the commands without prompts, e.g. naf model post --fields "title:string!" --crud
 * The positionals are the names, e.g. the model name
 */
let options = {};
let positionals = [];
let argsError = '';
try {
  ({ values: options, positionals } = parseArgs({
    args: process.argv.slice(3),
    allowPositionals: true,
    options: {
      fields: { type: 'string' },
      crud: { type: 'boolean' },
      route: { type: 'string' },
      model: { type: 'string' },
      db: { type: 'string' },
      json: { type: 'boolean' }
    }
  }));
} catch (err) {
  argsError = err.message;
}

/**
 * Fields of a model, e.g. "title:string! body:string author:ref(user)"
 * Types: string, number, boolean, date, ref(<model>). A trailing ! means required
 */
const DEFAULT_FIELDS = 'name:string!';
const FIELD_REGEX = /^([a-z][a-zA-Z0-9]*):(string|number|boolean|date|ref\(([a-z]+(?:-[a-z]+)*)\))(!?)$/;
const RESERVED_FIELDS = ['id', '_id', '__v'];

/**
 * Parse the fields text
 * @output { fields, error } fields is a list of { name, type, ref, required }
 */
const parseFields = (text) => {
  const fields = [];
  const tokens = (text || '').split(/[\s,]+/).filter(Boolean);
  if (!tokens.length) {
    return { fields, error: 'At least one field is required, e.g. "title:string!"' };
  }
  for (const token of tokens) {
    const match = FIELD_REGEX.exec(token);
    if (!match) {
      return { fields, error: `Invalid field "${token}", use name:type with type string, number, boolean, date or ref(<model>), and ! for required` };
    }
    const [, name, type, ref, required] = match;
    if (RESERVED_FIELDS.includes(name)) {
      return { fields, error: `"${name}" is added automatically, remove it from the fields` };
    }
    if (fields.some((field) => field.name === name)) {
      return { fields, error: `Field "${name}" is defined twice` };
    }
    fields.push({ name, type: ref ? 'ref' : type, ref, required: required === '!' });
  }
  return { fields, error: '' };
};

const MONGOOSE_TYPES = { string: 'String', number: 'Number', boolean: 'Boolean', date: 'Date' };
const SCHEMA_TYPES = {
  string: `{ type: 'string' }`,
  number: `{ type: 'number' }`,
  boolean: `{ type: 'boolean' }`,
  date: `{ type: 'string', format: 'date-time' }`,
  ref: `{ type: 'string', pattern: '^[0-9a-fA-F]{24}$' }`
};

// fields of the mongoose model
const renderModelFields = (fields) => fields.map((field) => {
  const required = field.required ? ', required: true' : '';
  if (field.type === 'ref') {
    return `${field.name}: { type: mongoose.Schema.Types.ObjectId, ref: '${field.ref}'${required} }`;
  }
  return field.required ? `${field.name}: { type: ${MONGOOSE_TYPES[field.type]}${required} }` : `${field.name}: ${MONGOOSE_TYPES[field.type]}`;
}).join(',\n  ');

// body properties of the request schema
const renderSchemaProperties = (fields) => fields.map((field) => `${field.name}: ${SCHEMA_TYPES[field.type]}`).join(',\n    ');

const renderRequired = (fields) => `[${fields.filter((field) => field.required).map((field) => `'${field.name}'`).join(', ')}]`;

// models which already exist in the project
const existingModels = () => {
  const dir = `${srcDir}models`;
  return fs.existsSync(dir) ? fs.readdirSync(dir).filter((file) => file.endsWith('.model.ts')).map((file) => file.replace(/\.model\.ts$/, '')) : [];
};

// a ref must point to an existing model or a model created in the same command
const checkRefs = (fields, knownModels) => {
  const unknown = fields.find((field) => field.type === 'ref' && !knownModels.includes(field.ref));
  return unknown ? `Field "${unknown.name}" links to unknown model "${unknown.ref}", create it first or in the same plan` : '';
};

// default route of a model, e.g. post -> posts, category -> categories, box -> boxes
const pluralize = (name) => {
  if (/[^aeiou]y$/.test(name)) {
    return `${name.slice(0, -1)}ies`;
  }
  return /(s|x|z|ch|sh)$/.test(name) ? `${name}es` : `${name}s`;
};

// the commands which change a project must run at its root folder
const isProjectRoot = () => fs.existsSync(`${routeDir}app.route.ts`);

/**
 * Store metadata for files creating
 */
let todoList = {
  controller: null,
  model: null,
  route: null,
  schema: null
};

/**
 * Store notifications
 * @output added
 * @output failed
 * @output modified
 */
let notifications = {
  added: [],
  failed: [],
  modified: [],
  notes: []
};

/**
 * Store some common informations to create files
 * @note: hasCustom is a boolean, it is enabled when special value was set for route name
 */
let dataForGenerating = {
  controllerName: '',
  modelName: '',
  routeName: '',
  url: '',
  folderName: '',
  hasCustom: false
};

// fields of the generated model and request schema
let fieldsForGenerating = parseFields(DEFAULT_FIELDS).fields;

/**
 * Reset what was prepared for the previous resource, to generate several resources in one run
 */
const resetGenerating = () => {
  todoList = { controller: null, model: null, route: null, schema: null };
  dataForGenerating = { controllerName: '', modelName: '', routeName: '', url: '', folderName: '', hasCustom: false };
  fieldsForGenerating = parseFields(DEFAULT_FIELDS).fields;
};

/**
 * Regrex definitions
 * 1. Model for model name validation
 * 2. Controller for controller and route name validation
 */
const INQUIRER_REGEX = {
  model: /^[a-z]+(-[a-z]+)*$/,
  controller: /^([a-z]+(-[a-z]+)*)+(\/([a-z]+(-[a-z]+)*))*$/
};

/**
 * General steps for generating file
 * 1. Model
 * 2. Controller
 * 3. Route
 */
const INQUIRER_STEPS = {
  model: {
    name: 'name',
    type: 'input',
    message: 'Enter your Model name:',
    validate: function (input) {
      if (INQUIRER_REGEX.model.test(input)) {
        return true;
      } else {
        return 'Model name should be an alias (lower letters - kebab-case).';
      }
    }
  },
  controller: {
    name: 'name',
    type: 'input',
    message: 'Enter your Controller:',
    validate: function (input) {
      if (INQUIRER_REGEX.controller.test(input)) {
        return true;
      } else {
        return 'Controller name should be an alias or relative path.';
      }
    }
  },
  fields: {
    name: 'fields',
    type: 'input',
    message: 'Enter fields (e.g. title:string! price:number author:ref(user)):',
    default: DEFAULT_FIELDS,
    validate: function (input) {
      return parseFields(input).error || true;
    }
  },
  route: (name) => {
    return {
      name: 'name',
      type: 'input',
      message: 'Enter Route name:',
      default: pluralize(name),
      validate: function (input) {
        if (INQUIRER_REGEX.controller.test(input)) {
          return true;
        } else {
          return 'Route name should be an alias or relative path.';
        }
      }
    }
  }
};

/**
 * Step for initing project
 * @steps
 * 1. Require enter Project name
 * 2. Enter Database name
 */
const PROJECT_INIT_STEPS = [
  {
    name: 'projectName',
    type: 'input',
    message: 'Your Project name:',
    validate: function (input) {
      if (input) {
        return true;
      } else {
        return 'Project name is required!';
      }
    }
  },
  {
    name: 'dbName',
    type: 'input',
    message: 'Your Database name:',
    validate: function (input) {
      if (input) {
        return true;
      } else {
        return 'Database name is required!';
      }
    }
  }
]

/**
 * Steps for creating model
 * @steps
 * 1. Require enter model name
 * 2. Ask for creating CRUD actions and controller
 */
const CREATING_MODEL_STEPS = [
  INQUIRER_STEPS.model,
  INQUIRER_STEPS.fields,
  {
    name: 'hasAction',
    type: 'confirm',
    message: 'Initing CRUD actions and routing?'
  }
];

/**
 * Steps for creating controller
 * @steps
 * 1. Require enter controller name
 */
const CREATING_CONTROLLER_STEPS = [
  INQUIRER_STEPS.controller
];

/**
 * Define metadata to create new file
 * @param type is type of file ['model', 'controller', 'route', 'schema']
 * @param fileName is name of file
 * @output new object it's contain a file metadata
 */
const newFileObj = (type, fileName) => {
  let folderOfType = `${type}s`;
  let objName = fileName;
  let folderDir = '';
  if (type === 'schema') {
    objName = kebabToCamel(fileName);
  } else if (type === 'controller' && dataForGenerating.modelName) {
    // crud controller must point to the chosen model, not to itself
    objName = dataForGenerating.modelName;
  } else if (type === 'route') {
    // objName = dataForGenerating.routeName
  }
  // all models will generating in root of models folder
  if (dataForGenerating.folderName && type !== 'model') {
    folderDir = `/${dataForGenerating.folderName}`;
  }
  return {
    type: type,
    name: objName,
    fileName: `${fileName}.${type}.ts`,
    dir: `${srcDir}${folderOfType}${folderDir}`,
    folderName: dataForGenerating.folderName,
    templateDir: dataForGenerating.templateDir || templateCrudDir
  }
};

/**
 * Adding task to todolist if have controller
 */
const defineActions = (hasAction) => {
  if (dataForGenerating.controllerName) {
    let newFiles = {
      controller: newFileObj('controller', dataForGenerating.controllerName),
      route: newFileObj('route', dataForGenerating.controllerName),
      schema: newFileObj('schema', dataForGenerating.controllerName)
    };
    todoList = { ...todoList, ...newFiles };
  }
  processFiles();
}

/**
 * Config for new project generate
 */
const projectConfig = (options) => {
  // project generated
  const writePath = `${options.projectDir}/`;
  // project options template
  const optionPath = `${projectInitDir}/options/`;
  // files need to change
  const files = [
    'src/config/db.ts',
    'package.json'
  ];
  let contents;
  for (let fileName of files) {
    contents = fs.readFileSync(`${optionPath}${fileName}`, 'utf8');
    // modify content
    contents = contents.replace(/__PROJECT_NAME__/g, options.projectName);
    // modify content
    contents = contents.replace(/__DB_NAME__/g, options.dbName);
    // create a new file with contents
    fs.writeFileSync(`${writePath}${fileName}`, contents, 'utf8');
  }
  // npm does not publish .gitignore files, so the template keeps it as gitignore
  if (fs.existsSync(`${writePath}gitignore`)) {
    fs.renameSync(`${writePath}gitignore`, `${writePath}.gitignore`);
  }
}

/**
 * Print an error and exit with code 1
 */
const fail = (message) => {
  if (options.json) {
    console.log(JSON.stringify({ error: message }));
  } else {
    console.log(chalk.red(message));
  }
  process.exitCode = 1;
};

// the prompts only work in a terminal, otherwise the names must be passed as arguments
// NAF_FORCE_PROMPTS=1 lets the smoke test answer the prompts through a pipe
const canPrompt = () => (Boolean(process.stdin.isTTY && process.stdout.isTTY) || process.env.NAF_FORCE_PROMPTS === '1') && !options.json;

// paths in the output are relative to the folder naf runs in
const relative = (file) => path.relative(projectDir, file).split(path.sep).join('/');

const notProjectRoot = () => fail(`Run '${cmdAlias} ${actor}' at the root folder of a Naf project`);

/**
 * Check the name, route and fields of a new model
 * @param knownModels models a ref may point to
 * @output { fields, error }
 */
const checkModel = ({ name, fieldsText, route, crud }, knownModels) => {
  if (!INQUIRER_REGEX.model.test(name)) {
    return { fields: [], error: `Invalid model name "${name}", use lower letters in kebab-case, e.g. order-item` };
  }
  if (existingModels().includes(name)) {
    return { fields: [], error: `Model "${name}" already exists` };
  }
  if (route && !crud) {
    return { fields: [], error: 'A route needs CRUD actions, add --crud' };
  }
  if (route && !INQUIRER_REGEX.controller.test(route)) {
    return { fields: [], error: `Invalid route "${route}", use an alias or a relative path in kebab-case` };
  }
  const { fields, error } = parseFields(fieldsText === undefined ? DEFAULT_FIELDS : fieldsText);
  return { fields, error: error || checkRefs(fields, knownModels) };
};

/**
 * Prepare the files of a new model, and of its CRUD controller, route and schema when crud is set
 */
const prepareModel = ({ name, fields, crud, route }) => {
  // define data to create model file
  todoList.model = newFileObj('model', name);
  fieldsForGenerating = fields;
  if (crud) {
    const routeName = route || pluralize(name);
    dataForGenerating.hasCustom = routeName !== `${name}s`;
    // define data to create controller file
    dataForGenerating.controllerName = name;
    // define data to create route file
    dataForGenerating.routeName = dataForGenerating.hasCustom ? routeName : name;
    // define data to create schema file
    dataForGenerating.schemaName = name;
  }
};

/**
 * Prepare the files of a controller, with CRUD actions when a model is set
 */
const prepareController = () => {
  if (dataForGenerating.modelName) {
    // template is crud template
    dataForGenerating.templateDir = templateCrudDir;
    // an existing model is used as it is
    if (!existingModels().includes(dataForGenerating.modelName)) {
      todoList.model = newFileObj('model', dataForGenerating.modelName);
    }
  } else {
    // template is empty template
    dataForGenerating.templateDir = templateNewDir;
  }
};

/**
 * Copy the Claude Code skill into a project
 * @output true if the skill was already installed
 */
const installSkill = (dir) => {
  const target = path.join(dir, skillPath);
  const existed = fs.existsSync(target);
  fs.mkdirSync(path.dirname(target), { recursive: true });
  fs.copyFileSync(templateSkillPath, target);
  return existed;
};

/**
 * Create a new project
 */
const createProject = (projectName, dbName) => {
  // create new dir by project name
  const newProjectDir = `${projectDir}/${projectName}`;
  if (fs.existsSync(newProjectDir)) {
    return fail(`${relative(newProjectDir)} already exists!`);
  }
  shell.mkdir('-p', newProjectDir);
  // copy source code to new project dir
  fsExtra.copySync(`${projectInitDir}/project/`, `${newProjectDir}/`);
  // change project metadata by config
  projectConfig({ projectName, dbName, projectDir: newProjectDir });
  installSkill(newProjectDir);
  if (options.json) {
    console.log(JSON.stringify({ project: projectName, dir: relative(newProjectDir) }));
  } else {
    console.log(chalk.cyan(`Project ${projectName} initialized!`));
  }
};

// files of a type in a folder and its sub folders, e.g. admin/report for admin/report.controller.ts
const listFiles = (dir, suffix, prefix = '') => {
  if (!fs.existsSync(dir)) {
    return [];
  }
  return fs.readdirSync(dir, { withFileTypes: true }).flatMap((entry) => {
    if (entry.isDirectory()) {
      return listFiles(path.join(dir, entry.name), suffix, `${prefix}${entry.name}/`);
    }
    return entry.name.endsWith(suffix) ? [`${prefix}${entry.name.slice(0, -suffix.length)}`] : [];
  });
};

/**
 * Define bash script
 * Every command runs with prompts in a terminal, or without prompts when its name is given as an argument
 * @options 
 * {
 *    init: for creating a new project,
 *    model: for creating model and the advance options allowing create CRUD actions, controler, schema, route too,
 *    controller: for creating contoller and the advance options allowing create CRUD actions for a specific model,
 *    plan: for creating several models with CRUD actions from a JSON file,
 *    list: for listing the models and controllers,
 *    skill: for adding the Claude Code skill to a project,
 *    help: for help
 * }
 */
const generator = {
  init: async () => {
    const [projectName] = positionals;
    if (projectName) {
      if (/[\\/]/.test(projectName)) {
        return fail(`Invalid project name "${projectName}", use a folder name without slashes`);
      }
      return createProject(projectName, options.db || projectName);
    }
    if (!canPrompt()) {
      return fail(`Usage: ${cmdAlias} init <project name> [--db <database name>]`);
    }
    const answers = await inquirer.prompt(PROJECT_INIT_STEPS);
    createProject(answers['projectName'], answers['dbName']);
  },
  model: async () => {
    if (!isProjectRoot()) {
      return notProjectRoot();
    }
    const [name] = positionals;
    if (name) {
      const { fields, error } = checkModel({ name, fieldsText: options.fields, route: options.route, crud: options.crud }, [...existingModels(), name]);
      if (error) {
        return fail(error);
      }
      prepareModel({ name, fields, crud: options.crud, route: options.route });
      defineActions();
      return report();
    }
    if (!canPrompt()) {
      return fail(`Usage: ${cmdAlias} model <name> [--fields "<field>:<type>[!] ..."] [--crud] [--route <route>]`);
    }
    const model = await inquirer.prompt(CREATING_MODEL_STEPS);
    const modelName = model['name'];
    const { fields, error } = checkModel({ name: modelName, fieldsText: model['fields'] }, [...existingModels(), modelName]);
    if (error) {
      return fail(error);
    }
    let route = '';
    if (model['hasAction']) {
      // require enter route name
      route = (await inquirer.prompt([INQUIRER_STEPS.route(modelName)]))['name'];
    }
    prepareModel({ name: modelName, fields, crud: model['hasAction'], route });
    defineActions();
    report();
  },
  controller: async () => {
    if (!isProjectRoot()) {
      return notProjectRoot();
    }
    const [controllerName] = positionals;
    if (controllerName) {
      if (!INQUIRER_REGEX.controller.test(controllerName)) {
        return fail(`Invalid controller "${controllerName}", use an alias or a relative path in kebab-case`);
      }
      if (options.route && !INQUIRER_REGEX.controller.test(options.route)) {
        return fail(`Invalid route "${options.route}", use an alias or a relative path in kebab-case`);
      }
      if (options.fields && !options.model) {
        return fail('Fields need a model, add --model <name>');
      }
      analystController(controllerName);
      dataForGenerating.routeName = options.route || pluralize(controllerName);
      dataForGenerating.hasCustom = dataForGenerating.routeName !== `${controllerName}s`;
      if (options.model) {
        if (!INQUIRER_REGEX.model.test(options.model)) {
          return fail(`Invalid model name "${options.model}", use lower letters in kebab-case, e.g. order-item`);
        }
        const { fields, error } = parseFields(options.fields === undefined ? DEFAULT_FIELDS : options.fields);
        const refError = error || checkRefs(fields, [...existingModels(), options.model]);
        if (refError) {
          return fail(refError);
        }
        dataForGenerating.modelName = options.model;
        fieldsForGenerating = fields;
      }
      prepareController();
      defineActions();
      return report();
    }
    if (!canPrompt()) {
      return fail(`Usage: ${cmdAlias} controller <name or path> [--route <route>] [--model <name> [--fields "<field>:<type>[!] ..."]]`);
    }
    const controller = await inquirer.prompt(CREATING_CONTROLLER_STEPS);
    const name = controller['name'];
    analystController(name);
    /**
     * Steps for creating route
     * @steps
     * 1. Require enter route name, default value is recommended
     * 2. Ask for creating CRUD actions for specific model
     */
    const route = await inquirer.prompt([
      INQUIRER_STEPS.route(name),
      {
        name: 'hasAction',
        type: 'confirm',
        message: 'Initing CRUD actions?',
        default: false
      }
    ]);
    dataForGenerating.hasCustom = route['name'] !== `${name}s`;
    dataForGenerating.routeName = route['name'];
    // if CRUD actions are choosed
    if (route['hasAction']) {
      // Require enter model name and its fields
      const model = await inquirer.prompt([INQUIRER_STEPS.model, INQUIRER_STEPS.fields]);
      const { fields } = parseFields(model['fields']);
      const refError = checkRefs(fields, [...existingModels(), model['name']]);
      if (refError) {
        return fail(refError);
      }
      dataForGenerating.modelName = model['name'];
      fieldsForGenerating = fields;
    }
    prepareController();
    defineActions();
    report();
  },
  plan: async () => {
    if (!isProjectRoot()) {
      return notProjectRoot();
    }
    const [file] = positionals;
    if (!file) {
      return fail(`Usage: ${cmdAlias} plan <plan.json | -> with {"resources":[{"name":"post","fields":"title:string! body:string"}]}`);
    }
    let plan;
    try {
      plan = JSON.parse(fs.readFileSync(file === '-' ? 0 : file, 'utf8'));
    } catch (err) {
      return fail(`Cannot read the plan: ${err.message}`);
    }
    const resources = Array.isArray(plan) ? plan : plan?.resources;
    if (!Array.isArray(resources) || !resources.length) {
      return fail('The plan must look like {"resources":[{"name":"post","fields":"title:string!"}]}');
    }
    // check everything first, so nothing is generated when the plan has a mistake
    const names = resources.map((resource) => resource?.name);
    const knownModels = [...existingModels(), ...names];
    const errors = [];
    const prepared = resources.map((resource, i) => {
      const label = typeof resource?.name === 'string' ? resource.name : `resource ${i + 1}`;
      if (typeof resource?.name !== 'string') {
        errors.push(`${label}: name is required`);
        return null;
      }
      if (names.indexOf(resource.name) !== i) {
        errors.push(`${label}: defined twice`);
      }
      const crud = resource.crud !== false;
      const fieldsText = Array.isArray(resource.fields) ? resource.fields.join(' ') : resource.fields;
      const { fields, error } = checkModel({ name: resource.name, fieldsText, route: resource.route, crud }, knownModels);
      if (error) {
        errors.push(`${label}: ${error}`);
      }
      return { name: resource.name, fields, crud, route: resource.route };
    });
    if (errors.length) {
      return fail(`Nothing was generated:\n${errors.join('\n')}`);
    }
    for (const resource of prepared) {
      resetGenerating();
      prepareModel(resource);
      defineActions();
    }
    report();
  },
  list: () => {
    if (!isProjectRoot()) {
      return notProjectRoot();
    }
    const result = { models: existingModels(), controllers: listFiles(`${srcDir}controllers`, '.controller.ts') };
    if (options.json) {
      return console.log(JSON.stringify(result));
    }
    console.log(chalk.cyan('Models:'), result.models.join(', ') || '-');
    console.log(chalk.cyan('Controllers:'), result.controllers.join(', ') || '-');
  },
  skill: () => {
    if (!isProjectRoot()) {
      return notProjectRoot();
    }
    const updated = installSkill(projectDir);
    if (options.json) {
      return console.log(JSON.stringify({ skill: skillPath, updated }));
    }
    console.log(chalk.cyan(`Claude Code skill ${updated ? 'updated' : 'added'}: ${skillPath}`));
  },
  help: () => {
    console.log(chalk.yellow(`'${cmdAlias} init [name] [--db <name>]' to init a new project`));
    console.log(chalk.yellow(`'${cmdAlias} model [name] [--fields "title:string! price:number author:ref(user)"] [--crud] [--route <route>]' to create model`));
    console.log(chalk.yellow(`'${cmdAlias} controller [name] [--route <route>] [--model <name> [--fields "..."]]' to create controller`));
    console.log(chalk.yellow(`'${cmdAlias} plan <plan.json | ->' to create several models with CRUD actions`));
    console.log(chalk.yellow(`'${cmdAlias} list' to list the models and controllers`));
    console.log(chalk.yellow(`'${cmdAlias} skill' to add the Claude Code skill to a project`));
    console.log(chalk.yellow(`Without a name, the command asks for it. Add --json for a JSON output.`));
  }
}

/**
 * Main duty
 */
const run = async () => {
  if (argsError) {
    return fail(argsError);
  }
  if (generator[actor] && typeof generator[actor] === 'function') {
    try {
      await generator[actor]();
    } catch (err) {
      fail(err.message);
    }
  } else {
    fail(`The specified command ${actor} is invalid. For available options, see '${cmdAlias} help'.`);
  }
}

/**
 * Analyst Controller
 * Analyst controller name which enter from cmd to two patterns:
 * 1. Controller name
 * 2. A folder contained controller
 */
const analystController = (str) => {
  let hasFolder = false;
  let arr = str.split('/');
  let length = arr.length;
  if (length === 1) {
    // controller name is an alias
    dataForGenerating.controllerName = arr[0];
  } else {
    // controller name is an a relative path
    hasFolder = true;
    // set controller name is last path of the input
    dataForGenerating.controllerName = arr[length - 1];
    // set folder name is remain of input excluded controller name
    dataForGenerating.folderName = arr.slice(0, -1).join('/');
  }
}

/**
 * Process file
 */
const processFiles = () => {
  let target = {};
  for (let key in todoList) {
    target = todoList[key];
    if (target) {
      createDirectoryContents(target, key === 'route');
    }
  }
}

/**
 * Print what was generated, as JSON with --json
 */
const report = () => {
  if (options.json) {
    console.log(JSON.stringify({
      added: notifications.added.map((obj) => obj.name),
      modified: notifications.modified.map((obj) => obj.name),
      failed: notifications.failed.map((obj) => obj.msg),
      notes: notifications.notes.map((obj) => obj.msg)
    }));
  } else {
    processNotifications();
  }
  if (notifications.failed.length) {
    process.exitCode = 1;
  }
}

/**
 * Display notifications after files created
 */
const processNotifications = () => {
  const typeMsgs = {
    added: `File(s) added:`
  };
  let notification;
  for (let key in notifications) {
    notification = notifications[key];
    if (typeMsgs[key] && notification && notification.length) {
      console.log(chalk.cyan(`${typeMsgs[key]}`));
    }
    for (let obj of notification) {
      console.log(chalk[obj.msgType](`${obj.msg}`));
    }
  }
}

/**
 * Generating new file
 * @params target is file output metadata
 * @params isRoute check if the output file is route or not? to process another action
 */
const createDirectoryContents = (target, isRoute = false) => {
  if (!fs.existsSync(target['dir'])) {
    shell.mkdir('-p', target['dir']);
  }
  // get template file
  const origFilePath = `${target['templateDir']}${target['type']}.ts`;
  const stats = fs.statSync(origFilePath);
  let fileCreated = '';
  let secondReplace = '';
  let thirdReplace = ''
  // check file or folder
  if (stats.isFile()) {
    const writePath = `${target['dir']}/${target['fileName']}`;
    const shownPath = relative(writePath);
    if (fs.existsSync(writePath)) {
      // define error message if a file is exists
      notifications.failed.push({
        name: shownPath,
        msg: `${shownPath} file already exists`,
        msgType: 'red'
      });
    } else {
      // read template content
      let contents = fs.readFileSync(origFilePath, 'utf8');
      // modify content
      contents = contents.replace(/__MODEL__/g, target['name']);
      // if file contained in nested folder, declare it to get correct route
      if (target['folderName']) {
        thirdReplace = `,\n\tdir: '${target['folderName']}/'`
      } else {
        thirdReplace = '';
      }
      // if specific path is defined, transfer it to get correct route
      if (dataForGenerating.hasCustom) {
        secondReplace = `,\n\tpath: '${dataForGenerating.routeName}'`;
      } else {
        secondReplace = '';
      }
      // modify content
      contents = contents.replace(/'__DIR__'/g, thirdReplace);
      // modify content
      contents = contents.replace(/'__PATH__'/g, secondReplace);
      // fields of the model and of the request schema, replaced by functions so a $ in them is kept as it is
      contents = contents.replace(/__FIELDS__/g, () => renderModelFields(fieldsForGenerating));
      contents = contents.replace(/__BODY_PROPERTIES__/g, () => renderSchemaProperties(fieldsForGenerating));
      contents = contents.replace(/__REQUIRED__/g, () => renderRequired(fieldsForGenerating));
      // create a new file with contents
      fs.writeFileSync(writePath, contents, 'utf8');
      // define message after file created
      notifications.added.push({
        name: shownPath,
        msg: shownPath,
        msgType: 'cyan'
      });
      if (isRoute) {
        // update index route
        let fileName = modifyAppRoute(target['name']);
        if (fileName && notifications.modified.some((obj) => obj.name === relative(fileName))) {
          // app route was already reported as modified
        } else if (fileName) {
          // define message in case app route is updated
          notifications.modified.push({
            name: relative(fileName),
            msg: `${relative(fileName)} was modified.`,
            msgType: 'yellow'
          });
        } else {
          // define message in case app route is not updated
          notifications.notes.push({
            name: shownPath,
            msg: `${shownPath} was defined, please import it into src/routes/app.route.ts.`,
            msgType: 'yellow'
          });
        }
      }
    }
  }
}

/**
 * Modify App Route
 * Modify app route if the new route was created
 * @param name is name of  the new route, which just created
 */
const modifyAppRoute = (name) => {
  const indexRoutes = `${routeDir}app.route.ts`;
  const routeName = `${kebabToCamel(name)}Route`;
  const routeFile = `${name}.route`;
  let fileContents = fs.readFileSync(`${indexRoutes}`, 'utf8');
  // work with LF line endings so the regexes also match files checked out with CRLF (Windows)
  const eol = fileContents.includes('\r\n') ? '\r\n' : '\n';
  fileContents = fileContents.replace(/\r\n/g, '\n');
  const regex = /(export default \[)(.|\n)*(\])/g;
  // module.exports = []
  const checkModuleNull = /(export default \[)(\n)*(\])/g;
  // ...namefile, or ...namefile, // comment 
  const checkLastLine = /[a-zA-Z]+\,\s*[\sa-zA-Z\/\/]*\n\]/g;
  //...namefile // comment 
  const checkLastLineSpecialComma = /[a-zA-Z]+\s\/\/(\s?[a-z]+)?\n*\]/g;
  const checkBreakline = /\n*(?=(export default \[)(.|\n)*(\]))/g;
  const findModuleToInsertImport = /\n(?=\nexport default)/g;

  // app route has content & the new route contained in root route folder
  if (regex.test(fileContents) && !dataForGenerating.folderName) {
    // check content of the app route to modify right way
    switch (true) {
      case checkModuleNull.test(fileContents):
        break;
      case checkLastLineSpecialComma.test(fileContents):
        fileContents = fileContents.replace(/\s(?=\/\/.*\n*\])/g, `, `);
        break
      case checkLastLine.test(fileContents):
        break
      default:
        fileContents = fileContents.replace(/\n*\]/g, `,\n]`);
    }
    // pushing new route inside module export
    fileContents = fileContents.replace(/\n*\]/g, `\n\t...${routeName}\n]`);
    fileContents = fileContents.replace(checkBreakline, '\n');
    // requiring new route before module export
    fileContents = fileContents.replace(findModuleToInsertImport, `\nimport ${routeName} from './${routeFile}'\n`);
    // apply new content to the app route, keeping its original line endings
    fs.writeFileSync(`${indexRoutes}`, fileContents.replace(/\n/g, eol), 'utf8');
    return `${indexRoutes}`;
  } else {
    return false;
  }
}

/**
 * Transform data
 * @input abc-zyz
 * @output abcXyz
 */
const kebabToCamel = (string) => {
  return string = string.replace(/-([a-z])/g, (g) => {
    return g[1].toUpperCase(); 
  });
};

/**
 * Transform data
 * @input abc-zyz
 * @output AbcXyz
 */
const kebabToUpperCamel = (string) => {
  string = string.replace(/-([a-z])/g, (g) => {
    return g[1].toUpperCase(); 
  });
  return string.replace(/\b\w/g, (l) => l.toUpperCase());
};

// run main action for generating
await run();
